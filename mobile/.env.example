# Vertical Express — mobile shell configuration.
#
# The origin the shell loads. Must be https. The build fails if it is unset or
# invalid (see app.config.ts) rather than shipping a binary that loads nothing.
#
# EAS builds do not need this file — eas.json sets the value per profile. This is
# only for running the app locally against a different origin (a preview
# deployment, say). Copy to mobile/.env and edit.
#
# Canonical host per KNOWN_ISSUES ISS-018, verified serving the production site.
EXPO_PUBLIC_SITE_URL=https://www.verticalexpress.in
