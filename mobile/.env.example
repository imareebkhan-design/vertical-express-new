# Vertical Express — mobile shell configuration.
#
# The shell loads the deployed Vertical Express web application. This is the
# origin it loads. It must be https. The build fails if it is unset or invalid
# (see app.config.ts) rather than shipping a binary that loads nothing.
#
# The canonical production domain is NOT yet decided — the repository currently
# references verticalexpress.app / .co / .com / .dev / .in in different places
# (KNOWN_ISSUES ISS-018). Confirm it with the owner before any store build.
#
# For EAS builds, set this as an environment variable on the EAS project at
# expo.dev rather than committing it here.
EXPO_PUBLIC_SITE_URL=
