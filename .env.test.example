# Test database configuration. Copy to .env.test — never commit .env.test.
#
# The suite creates and mutates real rows (orders, payments, webhook events,
# inventory), so it must never share a database with the application.
# test-support/db-guard.mjs refuses to run without VE_TEST_DATABASE=1.
#
# Local Postgres is the default. Set it up once with:
#   brew services start postgresql@17
#   cp .env.test.example .env.test   (edit the user below to your OS username)
#   npm run db:test:setup

DATABASE_URL="postgresql://YOUR_OS_USERNAME@localhost:5432/vertical_express_test?schema=public"
DIRECT_URL="postgresql://YOUR_OS_USERNAME@localhost:5432/vertical_express_test?schema=public"

# Asserts this database is disposable. The suite will not run without it.
VE_TEST_DATABASE=1

# Only if you deliberately use a dedicated REMOTE test database — never the app's.
# VE_TEST_DATABASE_ALLOW_REMOTE=1

NODE_ENV=test
PAYMENT_GATEWAY=dummy
AUTH_OTP_CHANNEL=email
NEXT_PUBLIC_SITE_URL=http://localhost:3000
