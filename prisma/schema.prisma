/// Append-only forensic record for anything touching money, stock, price or
/// order state (ISS-015). OrderStatusEvent covers order transitions only and is
/// customer-facing history; this is the operator-facing trail — who did it, from
/// what, to what, and from where.
///
/// Written in the SAME transaction as the change it records, so a mutation that
/// commits without its audit row is impossible. Never updated, never deleted.
model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorType  AuditActor @map("actor_type")
  /// Null for system/webhook actors, which have no user row.
  actorId    String?    @map("actor_id") @db.Uuid
  action     String
  entityType String     @map("entity_type")
  entityId   String     @map("entity_id")
  /// State before and after, as JSON. Only the fields that changed.
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditActor {
  admin
  customer
  system

  @@map("audit_actor")
}

/// Why a stock level changed. Every movement carries one — a count that
/// disagrees with the shelf is settled by reading the reasons, and "adjusted"
/// with no reason is the row that starts an argument nobody can finish.
enum StockMovementReason {
  /// Physical recount against the shelf.
  recount
  /// Arrived from a supplier. Becomes a goods-receipt link when POs exist.
  received
  /// Broken, wet, or otherwise unsellable.
  damaged
  /// Counted before, cannot be found now.
  lost
  /// Moved to another warehouse.
  transfer
  /// Taken by an order. Written by the checkout path, not by a person.
  sold
  /// Came back from a customer.
  returned
  /// A correction to an earlier movement.
  correction
}

/// One change to one variant's stock at one warehouse.
///
/// The decrement at checkout was already race-free and transactional, but it
/// left no trace: stock went from 240 to 206 and nothing said why or who. That
/// is fine until the shelf disagrees with the screen, at which point there is
/// nothing to read and the argument is unwinnable.
///
/// Append-only by convention — a mistake is corrected with another row carrying
/// `correction`, never by editing history. `qtyAfter` is stored rather than
/// derived so a ledger page can be read without replaying every prior row, and
/// so a divergence between the two is itself detectable.
model StockMovement {
  id          String              @id @default(uuid()) @db.Uuid
  variantId   String              @map("variant_id") @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  /// Signed. Negative removes stock.
  qtyDelta    Int                 @map("qty_delta")
  /// On-hand immediately after this movement was applied.
  qtyAfter    Int                 @map("qty_after")
  reason      StockMovementReason
  /// Free text from the person making the change. Required for a recount.
  note        String?
  /// Who did it. Null for movements the system makes, such as a sale.
  actorEmail  String?             @map("actor_email")
  /// The order that caused it, when a sale or a return did.
  orderId     String?             @map("order_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([variantId, warehouseId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("stock_movements")
}
