generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

/// MIGRATIONS TRAVEL OVER directUrl, NOT url.
///
/// `prisma migrate` uses `directUrl` because the pooler cannot hold the
/// advisory lock a migration needs. The consequence is a trap that has already
/// been sprung once: overriding only DATABASE_URL to aim a migration at a local
/// database does nothing — `migrate deploy` reads DIRECT_URL, finds the
/// production value in .env, and migrates production instead. The command looks
/// local and is not.
///
/// Override BOTH, or use `npm run db:migrate:local`.
datasource db {
  provider = "postgresql"
}

/// Mirrors Supabase auth.users (id = auth.uid). Populated on first login.
model User {
  id          String             @id @db.Uuid
  /// Clerk's user id. Retained through the expand phase of the move to Firebase
  /// so a rollback does not lose the mapping; drops in a later release once
  /// nothing reads it (expand → migrate → contract).
  clerkId     String?            @unique @map("clerk_id")
  /// Firebase Auth's uid — the current identity mapping. Added alongside the
  /// UUID primary key, never replacing it: Address, Order, Cart and Wallet all
  /// reference `id`, and retyping a primary key under live foreign keys is a
  /// rewrite, not a migration.
  firebaseUid String?            @unique @map("firebase_uid")
  phone       String?            @unique
  email       String?            @unique
  role        Role               @default(customer)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  addresses   Address[]
  cart        Cart?
  orders      Order[]
  profile     Profile?
  redemptions CouponRedemption[]
  wishlist    Wishlist?
  wallet      Wallet?

  @@map("users")
}

model Profile {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @unique @map("user_id") @db.Uuid
  fullName       String?    @map("full_name")
  avatarUrl      String?    @map("avatar_url")
  gstin          String?
  companyName    String?    @map("company_name")
  /// What the customer is buying as, which is a merchandising fact, not a
  /// permission. `Role` stays the authorization enum — conflating the two would
  /// mean a homeowner and a contractor differed in what they may *do*, when
  /// what actually differs is what they are shown first.
  buyerType      BuyerType? @map("buyer_type")
  marketingOptIn Boolean    @default(false) @map("marketing_opt_in")
  firstUtm       Json?      @map("first_utm")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  label      AddressLabel @default(home)
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  /// What the driver needs to know to actually reach the gate — "truck can
  /// reach the rear", "narrow lane, small vehicle only". Free text on purpose:
  /// Srinagar addresses are landmark-navigated and no structured field would
  /// capture it. Shown on the site card and carried to the shipment.
  accessNote String?      @map("access_note")
  city       String
  state      String
  pincode    String       @db.Char(6)
  isDefault  Boolean      @default(false) @map("is_default")
  deletedAt  DateTime?    @map("deleted_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([pincode])
  @@map("addresses")
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  slug           String         @unique
  name           String
  group          CategoryGroup  @default(other)
  imageUrl       String?        @map("image_url")
  description    String?
  isBulk         Boolean        @default(false) @map("is_bulk")
  sortOrder      Int            @default(0) @map("sort_order")
  isActive       Boolean        @default(true) @map("is_active")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  products       Product[]
  rooms          RoomCategory[]

  @@index([group, sortOrder])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("brands")
}

/// How fast a product actually moves, when the category default is wrong.
///
/// Speed has been derived from `Category.isBulk` — every cement is heavy, every
/// switch is fast. That holds for most of the catalogue and breaks at the edges:
/// a single 5 kg bag of white cement does not need a truck, and a 40-piece box
/// of tiles does. This lets whoever lists the product say so.
///
/// Null means "use the category", which is what almost everything should say.
enum DeliverySpeed {
  express
  scheduled
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  slug           String           @unique
  title          String
  brandId        String           @map("brand_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  description    String?
  /// [{ label: string, value: string }]
  specs          Json?
  unitLabel      String           @default("per piece") @map("unit_label")
  /// Overrides the category's speed for this one product. Null means the
  /// category decides, which is right for almost everything.
  deliverySpeed  DeliverySpeed?   @map("delivery_speed")
  status         ProductStatus    @default(published)
  isDeal         Boolean          @default(false) @map("is_deal")
  ratingAvg      Decimal          @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount    Int              @default(0) @map("rating_count")
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  images         ProductImage[]
  variants       ProductVariant[]
  brand          Brand            @relation(fields: [brandId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([isDeal, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  alt       String
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  sku            String          @unique
  name           String
  /// e.g. { size: "50 kg", color: "White" }
  attributes     Json?
  pricePaise     Int             @map("price_paise")
  compareAtPaise Int?            @map("compare_at_paise")
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  bulkTiers      BulkPriceTier[]
  cartItems      CartItem[]
  inventory      Inventory[]
  movements      StockMovement[]
  orderItems     OrderItem[]
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isDefault])
  @@map("product_variants")
}

model BulkPriceTier {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  minQty     Int            @map("min_qty")
  pricePaise Int            @map("price_paise")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
  @@map("bulk_price_tiers")
}

model Warehouse {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  city      String
  pincode   String               @db.Char(6)
  isActive  Boolean              @default(true) @map("is_active")
  createdAt DateTime             @default(now()) @map("created_at")
  inventory Inventory[]
  movements StockMovement[]
  orders    Order[]
  shipments Shipment[]
  pincodes  ServiceablePincode[]

  @@map("warehouses")
}

model Inventory {
  id                String         @id @default(uuid()) @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  warehouseId       String         @map("warehouse_id") @db.Uuid
  qtyOnHand         Int            @default(0) @map("qty_on_hand")
  qtyReserved       Int            @default(0) @map("qty_reserved")
  lowStockThreshold Int            @default(10) @map("low_stock_threshold")
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

model ServiceablePincode {
  id               String    @id @default(uuid()) @db.Uuid
  pincode          String    @unique @db.Char(6)
  warehouseId      String    @map("warehouse_id") @db.Uuid
  etaMinutes       Int       @default(60) @map("eta_minutes")
  deliveryFeePaise Int       @default(0) @map("delivery_fee_paise")
  codAllowed       Boolean   @default(true) @map("cod_allowed")
  isActive         Boolean   @default(true) @map("is_active")
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("serviceable_pincodes")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @map("user_id") @db.Uuid
  anonId    String?    @unique @map("anon_id") @db.Uuid
  couponId  String?    @map("coupon_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  qty       Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @unique @map("user_id") @db.Uuid
  items  WishlistItem[]
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique
  type             CouponType
  value            Int                @default(0)
  minOrderPaise    Int                @default(0) @map("min_order_paise")
  maxDiscountPaise Int?               @map("max_discount_paise")
  usageLimit       Int?               @map("usage_limit")
  perUserLimit     Int                @default(1) @map("per_user_limit")
  firstNOrders     Int?               @map("first_n_orders")
  startsAt         DateTime?          @map("starts_at")
  endsAt           DateTime?          @map("ends_at")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  /// Redemptions so far. Denormalised on purpose: a conditional increment
  /// against this column is the only way to enforce `usageLimit` without a
  /// race, exactly as `qtyOnHand` guards stock. Counting rows at read time
  /// cannot, because the count and the decision are two statements.
  redeemedCount    Int                @default(0) @map("redeemed_count")
  carts            Cart[]
  redemptions      CouponRedemption[]

  @@map("coupons")
}

/// One customer spending one coupon on one order.
///
/// `Order.couponCode` records WHICH coupon paid for a discount and is enough to
/// report on. It is not enough to enforce a limit: two orders placed in the
/// same instant both count the rows, both see room, and both proceed. That is
/// the residual race left open by ISS-066.
///
/// The two unique constraints close it, and each closes a different limit:
///
///   `orderId` — one redemption per order, so a retried placement cannot spend
///   the same coupon twice.
///
///   `(couponId, userId, useIndex)` — the Nth use by a given customer can only
///   exist once. Two concurrent orders both computing useIndex 2 collide on the
///   constraint and one is refused, which is what makes `perUserLimit` real.
///
/// The overall `usageLimit` is enforced separately, by a conditional increment
/// of `Coupon.redeemedCount` — a count across all customers cannot be expressed
/// as uniqueness, and the guard has the same shape as the stock decrement.
model CouponRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  /// 1 for this customer's first use of this coupon, 2 for the second.
  useIndex      Int      @map("use_index")
  /// What it actually took off, for reporting and for a refund to reverse.
  discountPaise Int      @map("discount_paise")
  createdAt     DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, useIndex])
  @@index([couponId, createdAt])
  @@map("coupon_redemptions")
}

model Order {
  id               String             @id @default(uuid()) @db.Uuid
  orderNo          String             @unique @map("order_no")
  /// Client-supplied key to make order placement idempotent (dedupes retries).
  idempotencyKey   String?            @unique @map("idempotency_key")
  userId           String             @map("user_id") @db.Uuid
  /// Snapshot of the delivery address at order time
  address          Json
  status           OrderStatus        @default(pending_payment)
  paymentMethod    PaymentMethod      @map("payment_method")
  subtotalPaise    Int                @map("subtotal_paise")
  discountPaise    Int                @default(0) @map("discount_paise")
  taxPaise         Int                @default(0) @map("tax_paise")
  deliveryFeePaise Int                @default(0) @map("delivery_fee_paise")
  totalPaise       Int                @map("total_paise")
  couponCode       String?            @map("coupon_code")
  etaMinutes       Int?               @map("eta_minutes")
  warehouseId      String?            @map("warehouse_id") @db.Uuid
  notes            String?
  placedAt         DateTime           @default(now()) @map("placed_at")
  deliveredAt      DateTime?          @map("delivered_at")
  cancelledReason  String?            @map("cancelled_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  items            OrderItem[]
  shipments        Shipment[]
  statusEvents     OrderStatusEvent[]
  couponRedemption CouponRedemption?
  user             User               @relation(fields: [userId], references: [id])
  warehouse        Warehouse?         @relation(fields: [warehouseId], references: [id])
  payments         Payment[]

  @@index([userId, placedAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @map("order_id") @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  title             String
  variantName       String         @map("variant_name")
  imageUrl          String?        @map("image_url")
  unitPricePaise    Int            @map("unit_price_paise")
  appliedTierMinQty Int?           @map("applied_tier_min_qty")
  qty               Int
  lineTotalPaise    Int            @map("line_total_paise")
  subtotalPaise     Int?           @map("subtotal_paise")
  discountPaise     Int?           @map("discount_paise")
  taxableValuePaise Int?           @map("taxable_value_paise")
  cgstPaise         Int?           @map("cgst_paise")
  sgstPaise         Int?           @map("sgst_paise")
  igstPaise         Int?           @map("igst_paise")
  gstRate           Decimal?       @map("gst_rate") @db.Decimal(5, 2)
  hsnCode           String?        @map("hsn_code")
  totalPaise        Int?           @map("total_paise")
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  gateway           PaymentMethod
  gatewayOrderId    String?       @map("gateway_order_id")
  gatewayPaymentId  String?       @map("gateway_payment_id")
  gatewayEventId    String?       @unique @map("gateway_event_id")
  amountPaise       Int           @map("amount_paise")
  status            PaymentStatus @default(created)
  signatureVerified Boolean       @default(false) @map("signature_verified")
  raw               Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model OrderStatusEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model ServiceCategory {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  blurb     String
  iconKey   String    @map("icon_key")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  services  Service[]

  @@index([sortOrder])
  @@map("service_categories")
}

model Service {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  categorySlug   String          @map("category_slug")
  name           String
  description    String?
  priceFromPaise Int?            @map("price_from_paise")
  unit           String?
  /// [{ q: string, a: string }]
  faqs           Json?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  bookings       Booking[]
  category       ServiceCategory @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)

  @@index([categorySlug])
  @@map("services")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  bookingNo      String        @unique @map("booking_no")
  userId         String?       @map("user_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  name           String
  phone          String
  /// Snapshot of address or free-text location
  address        Json?
  propertyType   PropertyType  @default(house) @map("property_type")
  scope          String
  preferredDate  DateTime?     @map("preferred_date")
  status         BookingStatus @default(received)
  professionalId String?       @map("professional_id") @db.Uuid
  adminNotes     String?       @map("admin_notes")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  professional   Professional? @relation(fields: [professionalId], references: [id])
  service        Service       @relation(fields: [serviceId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bookings")
}

model Professional {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  phone      String
  trade      String
  city       String    @default("Srinagar")
  rating     Decimal   @default(0) @db.Decimal(2, 1)
  isVerified Boolean   @default(false) @map("is_verified")
  createdAt  DateTime  @default(now()) @map("created_at")
  bookings   Booking[]

  @@map("professionals")
}

/// A physically separate delivery within one order.
///
/// An order that mixes small goods with heavy material cannot have a single
/// arrival time: the wire goes out on a bike within the hour and the cement goes
/// on a truck. `Order.status` is one flat enum and cannot express that, which is
/// why this exists.
///
/// EXPAND PHASE: `Order.status` remains the authoritative order state for now and
/// is still written exactly as before. Shipments are recorded alongside it. The
/// contract step — deriving order state from its shipments — is a later release,
/// per the expand/migrate/contract rule in CLAUDE.md.
model Shipment {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  /// 1-based, stable. Renders as "Shipment 1 of 2" and orders the dispatch board.
  sequence     Int
  speedClass   SpeedClass     @map("speed_class")
  status       ShipmentStatus @default(pending)
  warehouseId  String?        @map("warehouse_id") @db.Uuid
  /// When we told the customer it would arrive. Null until slots exist.
  promisedAt   DateTime?      @map("promised_at")
  dispatchedAt DateTime?      @map("dispatched_at")
  deliveredAt  DateTime?      @map("delivered_at")
  /// Shared with the driver at the gate to confirm handover.
  deliveryCode String?        @map("delivery_code")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id])
  items        ShipmentItem[]

  @@unique([orderId, sequence])
  @@index([status])
  @@index([orderId])
  @@map("shipments")
}

/// Which order lines travel in which shipment, and how many of each.
///
/// References OrderItem rather than ProductVariant so the price snapshot taken at
/// order time is preserved, and so a single line can be split across shipments
/// when stock is partial.
model ShipmentItem {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  qty         Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

/// A room a homeowner shops by, as opposed to the trade taxonomy a contractor
/// shops by. Both reach the same categories from different directions — the app
/// canvas leads homeowners with "Shop by room" and contractors with the L1
/// groups.
model Room {
  id         String         @id @default(uuid()) @db.Uuid
  slug       String         @unique
  name       String
  sortOrder  Int            @default(0) @map("sort_order")
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  categories RoomCategory[]

  @@index([sortOrder])
  @@map("rooms")
}

/// Which categories a room surfaces, and in what order.
///
/// An explicit join rather than an implicit many-to-many because the ordering
/// is editorial: "Bathroom" leads with sanitaryware, not with whichever
/// category happens to sort first. A category belongs to many rooms — tiling is
/// in every one of them — so this cannot live on Category.
model RoomCategory {
  roomId     String   @map("room_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([roomId, categoryId])
  @@index([roomId, sortOrder])
  @@map("room_categories")
}

/// Operational settings the console edits, rather than values baked into code.
///
/// The cashback rate, the GST registration, the delivery windows and the default
/// catalogue sort are all business decisions that change without a deploy. Every
/// one of them was previously a constant in a source file or an environment
/// variable, which meant changing a cashback percentage required an engineer —
/// and, in the case of the 5% that was hardcoded, meant nobody noticed it was
/// paying out at all.
///
/// Deliberately a typed key/value table rather than a column per setting: these
/// are read rarely, edited by hand, and the set of them grows. A column per
/// setting turns every new toggle into a migration.
model Setting {
  key       String   @id
  value     String
  /// Free text for the console — what this controls and what changing it does.
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

