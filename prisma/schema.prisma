generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors Supabase auth.users (id = auth.uid). Populated on first login.
model User {
  id        String    @id @db.Uuid
  phone     String?   @unique
  email     String?   @unique
  role      Role      @default(customer)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  addresses Address[]
  cart      Cart?
  orders    Order[]
  profile   Profile?
  wishlist  Wishlist?
  wallet    Wallet?

  @@map("users")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  fullName       String?  @map("full_name")
  avatarUrl      String?  @map("avatar_url")
  gstin          String?
  companyName    String?  @map("company_name")
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  firstUtm       Json?    @map("first_utm")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  label     AddressLabel @default(home)
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String       @db.Char(6)
  isDefault Boolean      @default(false) @map("is_default")
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([pincode])
  @@map("addresses")
}

model Category {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  name           String
  group          CategoryGroup @default(other)
  imageUrl       String?       @map("image_url")
  description    String?
  isBulk         Boolean       @default(false) @map("is_bulk")
  sortOrder      Int           @default(0) @map("sort_order")
  isActive       Boolean       @default(true) @map("is_active")
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  products       Product[]

  @@index([group, sortOrder])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("brands")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  slug           String           @unique
  title          String
  brandId        String           @map("brand_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  description    String?
  /// [{ label: string, value: string }]
  specs          Json?
  unitLabel      String           @default("per piece") @map("unit_label")
  status         ProductStatus    @default(published)
  isDeal         Boolean          @default(false) @map("is_deal")
  ratingAvg      Decimal          @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount    Int              @default(0) @map("rating_count")
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  images         ProductImage[]
  variants       ProductVariant[]
  brand          Brand            @relation(fields: [brandId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([isDeal, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  alt       String
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  sku            String          @unique
  name           String
  /// e.g. { size: "50 kg", color: "White" }
  attributes     Json?
  pricePaise     Int             @map("price_paise")
  compareAtPaise Int?            @map("compare_at_paise")
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  bulkTiers      BulkPriceTier[]
  cartItems      CartItem[]
  inventory      Inventory[]
  orderItems     OrderItem[]
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isDefault])
  @@map("product_variants")
}

model BulkPriceTier {
  id         String         @id @default(uuid()) @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  minQty     Int            @map("min_qty")
  pricePaise Int            @map("price_paise")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
  @@map("bulk_price_tiers")
}

model Warehouse {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  city      String
  pincode   String               @db.Char(6)
  isActive  Boolean              @default(true) @map("is_active")
  createdAt DateTime             @default(now()) @map("created_at")
  inventory Inventory[]
  orders    Order[]
  pincodes  ServiceablePincode[]

  @@map("warehouses")
}

model Inventory {
  id                String         @id @default(uuid()) @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  warehouseId       String         @map("warehouse_id") @db.Uuid
  qtyOnHand         Int            @default(0) @map("qty_on_hand")
  qtyReserved       Int            @default(0) @map("qty_reserved")
  lowStockThreshold Int            @default(10) @map("low_stock_threshold")
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

model ServiceablePincode {
  id               String    @id @default(uuid()) @db.Uuid
  pincode          String    @unique @db.Char(6)
  warehouseId      String    @map("warehouse_id") @db.Uuid
  etaMinutes       Int       @default(60) @map("eta_minutes")
  deliveryFeePaise Int       @default(0) @map("delivery_fee_paise")
  codAllowed       Boolean   @default(true) @map("cod_allowed")
  isActive         Boolean   @default(true) @map("is_active")
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("serviceable_pincodes")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @map("user_id") @db.Uuid
  anonId    String?    @unique @map("anon_id") @db.Uuid
  couponId  String?    @map("coupon_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  qty       Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @unique @map("user_id") @db.Uuid
  items  WishlistItem[]
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Coupon {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  type             CouponType
  value            Int        @default(0)
  minOrderPaise    Int        @default(0) @map("min_order_paise")
  maxDiscountPaise Int?       @map("max_discount_paise")
  usageLimit       Int?       @map("usage_limit")
  perUserLimit     Int        @default(1) @map("per_user_limit")
  firstNOrders     Int?       @map("first_n_orders")
  startsAt         DateTime?  @map("starts_at")
  endsAt           DateTime?  @map("ends_at")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  carts            Cart[]

  @@map("coupons")
}

model Order {
  id               String             @id @default(uuid()) @db.Uuid
  orderNo          String             @unique @map("order_no")
  /// Client-supplied key to make order placement idempotent (dedupes retries).
  idempotencyKey   String?            @unique @map("idempotency_key")
  userId           String             @map("user_id") @db.Uuid
  /// Snapshot of the delivery address at order time
  address          Json
  status           OrderStatus        @default(pending_payment)
  paymentMethod    PaymentMethod      @map("payment_method")
  subtotalPaise    Int                @map("subtotal_paise")
  discountPaise    Int                @default(0) @map("discount_paise")
  taxPaise         Int                @default(0) @map("tax_paise")
  deliveryFeePaise Int                @default(0) @map("delivery_fee_paise")
  totalPaise       Int                @map("total_paise")
  couponCode       String?            @map("coupon_code")
  etaMinutes       Int?               @map("eta_minutes")
  warehouseId      String?            @map("warehouse_id") @db.Uuid
  notes            String?
  placedAt         DateTime           @default(now()) @map("placed_at")
  deliveredAt      DateTime?          @map("delivered_at")
  cancelledReason  String?            @map("cancelled_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  items            OrderItem[]
  statusEvents     OrderStatusEvent[]
  user             User               @relation(fields: [userId], references: [id])
  warehouse        Warehouse?         @relation(fields: [warehouseId], references: [id])
  payments         Payment[]

  @@index([userId, placedAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @map("order_id") @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  title             String
  variantName       String         @map("variant_name")
  imageUrl          String?        @map("image_url")
  unitPricePaise    Int            @map("unit_price_paise")
  appliedTierMinQty Int?           @map("applied_tier_min_qty")
  qty               Int
  lineTotalPaise    Int            @map("line_total_paise")
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  gateway           PaymentMethod
  gatewayOrderId    String?       @map("gateway_order_id")
  gatewayPaymentId  String?       @map("gateway_payment_id")
  gatewayEventId    String?       @unique @map("gateway_event_id")
  amountPaise       Int           @map("amount_paise")
  status            PaymentStatus @default(created)
  signatureVerified Boolean       @default(false) @map("signature_verified")
  raw               Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model OrderStatusEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model ServiceCategory {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  blurb     String
  iconKey   String    @map("icon_key")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  services  Service[]

  @@index([sortOrder])
  @@map("service_categories")
}

model Service {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  categorySlug   String          @map("category_slug")
  name           String
  description    String?
  priceFromPaise Int?            @map("price_from_paise")
  unit           String?
  /// [{ q: string, a: string }]
  faqs           Json?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  bookings       Booking[]
  category       ServiceCategory @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)

  @@index([categorySlug])
  @@map("services")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  bookingNo      String        @unique @map("booking_no")
  userId         String?       @map("user_id") @db.Uuid
  serviceId      String        @map("service_id") @db.Uuid
  name           String
  phone          String
  /// Snapshot of address or free-text location
  address        Json?
  propertyType   PropertyType  @default(house) @map("property_type")
  scope          String
  preferredDate  DateTime?     @map("preferred_date")
  status         BookingStatus @default(received)
  professionalId String?       @map("professional_id") @db.Uuid
  adminNotes     String?       @map("admin_notes")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  professional   Professional? @relation(fields: [professionalId], references: [id])
  service        Service       @relation(fields: [serviceId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("bookings")
}

model Professional {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  phone      String
  trade      String
  city       String    @default("Srinagar")
  rating     Decimal   @default(0) @db.Decimal(2, 1)
  isVerified Boolean   @default(false) @map("is_verified")
  createdAt  DateTime  @default(now()) @map("created_at")
  bookings   Booking[]

  @@map("professionals")
}

enum Role {
  customer
  admin
  vendor
  professional
}

enum AddressLabel {
  home
  site
  office
  other
}

enum CategoryGroup {
  civil_interiors
  furniture_hardware
  electrical
  plumbing_bath
  tools
  other
}

enum ProductStatus {
  draft
  published
  archived
}

enum CouponType {
  percent
  flat
  free_delivery
}

enum OrderStatus {
  pending_payment
  confirmed
  packed
  out_for_delivery
  delivered
  cancelled
  refund_initiated
  refunded
}

enum PaymentMethod {
  dummy
  razorpay
  cod
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

enum PropertyType {
  apartment
  house
  plot
  commercial
}

enum BookingStatus {
  received
  scheduled
  visited
  quoted
  in_progress
  completed
  cancelled
}

/// Fixed-window rate limiter buckets (P1-4). Keyed by e.g. "otp:<email>".
model RateLimit {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String   @unique
  hits        Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start")

  @@map("rate_limits")
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @map("user_id") @db.Uuid
  balancePaise Int                 @default(0) @map("balance_paise")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  walletId     String                @map("wallet_id") @db.Uuid
  amountPaise  Int                   @map("amount_paise")
  type         WalletTransactionType
  referenceId  String?               @map("reference_id")
  description  String?
  expiresAt    DateTime?             @map("expires_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  cashback_credit
  order_debit
  refund_credit
  expired
}

