{
  "name": "vertical-express",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_PATH=./test-support/stubs node --env-file-if-exists=.env.test --import ./test-support/db-guard.mjs --import tsx --test \"lib/**/*.test.ts\"",
    "db:test:setup": "bash scripts/setup-test-db.sh",
    "db:test:reset": "bash scripts/setup-test-db.sh --reset",
