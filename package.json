{
  "name": "vertical-express",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-db-guard.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/build-guard.mjs",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_PATH=./test-support/stubs node --conditions=react-server --env-file-if-exists=.env.test --import ./test-support/db-guard.mjs --import tsx --test --test-concurrency=1 \"lib/**/*.test.ts\"",
    "db:test:setup": "bash scripts/setup-test-db.sh",
    "db:test:reset": "bash scripts/setup-test-db.sh --reset",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && node scripts/predeploy-migrations.mjs && next build",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "seo:categories": "npx tsx scripts/category-seo.mjs",
    "seo:products": "npx tsx scripts/product-copy.mjs",
    "dev:local": "DATABASE_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} DIRECT_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} next dev --turbopack --port 3100",
    "dev:demo": "DATABASE_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} DIRECT_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} next dev --turbopack --port 3000",
    "db:demo": "DATABASE_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} DIRECT_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} VE_TEST_DATABASE=1 npx tsx scripts/seed-demo-orders.mjs",
    "db:demo:setup": "DATABASE_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} DIRECT_URL=${DEMO_DATABASE_URL:-postgresql://$USER@localhost:5432/vertical_express_demo?schema=public} sh -c 'npx prisma migrate deploy && npx tsx prisma/seed.ts && npx tsx scripts/seed-real-brands.mjs'",
    "db:migrate:local": "DATABASE_URL=$LOCAL_TEST_DATABASE_URL DIRECT_URL=$LOCAL_TEST_DATABASE_URL prisma migrate deploy",
    "db:status": "prisma migrate status",
    "preflight": "npx tsx scripts/preflight.mjs",
    "start:smoke": "DATABASE_URL=${DEMO_DATABASE_URL:-postgresql://${USER}@localhost:5432/vertical_express_demo?schema=public} DIRECT_URL=${DEMO_DATABASE_URL:-postgresql://${USER}@localhost:5432/vertical_express_demo?schema=public} PAYMENT_GATEWAY=razorpay-live RAZORPAY_KEY_ID=PLACEHOLDER_LOCAL_SMOKE_TEST_ONLY RAZORPAY_KEY_SECRET=PLACEHOLDER_LOCAL_SMOKE_TEST_ONLY RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_LOCAL_SMOKE_TEST_ONLY next start --port 3200"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "latest",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "next": "15.5.23",
    "pg": "latest",
    "posthog-js": "^1.414.0",
    "prisma": "^7.9.1",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "nanoid": "^3.3.17",
    "brace-expansion": "^2.0.1",
    "js-yaml": "^5.2.1"
  }
}
