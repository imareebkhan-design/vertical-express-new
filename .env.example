# Supabase Postgres (pooled for the app, direct for migrations)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase project (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payments. "dummy" is refused in production — the app will not boot with it.
# Set to "razorpay-test" or "razorpay-live" once keys are provisioned.
PAYMENT_GATEWAY="dummy"

# Public site origin used in auth redirects, canonical URLs, robots.txt and the
# sitemap. MUST be set in production — if it is missing, robots and sitemap fall
# back to https://www.verticalexpress.in, which may not be the deployed host.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth channel: "email" sends 6-digit OTP codes via Supabase email
# NOTE: In Supabase Dashboard > Auth > Email, ensure "Enable email OTP" is ON
#       and "Enable magic link" can be left OFF for code-only login.
AUTH_OTP_CHANNEL="email"

# Admin allowlist (comma-separated emails)
ADMIN_EMAILS=""

# Razorpay (set these + PAYMENT_GATEWAY=razorpay to switch off the dummy gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---------------------------------------------------------------------------
# Optional services. Each no-ops when unset, so the app runs without them — but
# nothing is observed and no email is sent until they are configured.
# ---------------------------------------------------------------------------

# Transactional email (Resend). Without these, order and OTP emails silently
# do not send. EMAIL_FROM must be a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""

# Error monitoring (Sentry). Without a DSN, exceptions are logged to stdout only
# and nothing alerts. ISS-012.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Product analytics (PostHog). Without a key, no events are captured. ISS-012.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---------------------------------------------------------------------------
# Firebase Authentication — phone OTP and Google sign-in.
#
# ISS-053: production has NONE of these set, so nobody can sign in there. They
# were absent from this file too, which is a large part of why that went
# unnoticed — there was nothing to check the deployment against.
#
# The NEXT_PUBLIC_ ones are the web config. Every one of them ships to the
# browser and none is a secret: what protects the project is Firebase's own
# rules and the authorized-domain list, not the obscurity of the API key.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# The admin SDK, server-side. These ARE secret. FIREBASE_PRIVATE_KEY contains
# literal \n escapes and must keep its surrounding quotes.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# App Check — the only thing that can throttle OTP sends. ISS-047.
#
# The browser calls signInWithPhoneNumber directly against Google, so our server
# is not in the path and cannot rate-limit it. App Check attests the caller is
# our real app before Firebase will send an SMS; without it, an attacker can
# drive paid messages to numbers they control.
#
# Leave blank and App Check does not start, which is today's behaviour. Set the
# site key only after registering this site in the Firebase Console, or every
# sign-in fails instead of being protected. Roll out with enforcement OFF in the
# console first, watch the attestation metrics, then enforce.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=""
# "enterprise" for reCAPTCHA Enterprise; anything else uses reCAPTCHA v3.
NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER=""

# ---------------------------------------------------------------------------
# Tests use .env.test, never this file. See .env.test.example.
# ---------------------------------------------------------------------------
